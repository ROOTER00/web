@model List<Kurdixane.Web.Models.Category>
@{
    ViewData["Title"] = "Kategoriler";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="page-title mb-0">Kategoriler</h1>
    <a asp-action="Create" class="btn btn-primary"><i class="fa-solid fa-plus me-1"></i>Yeni Kategori</a>
</div>
<div class="admin-card">
    <div class="card-body p-0">
        <table class="table mb-0">
            <thead><tr><th>Ad</th><th>Slug</th><th>Üst Kategori</th><th>Sıra</th><th>Durum</th><th></th></tr></thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">Henüz kategori yok.</td></tr>
                }
                @foreach (var c in Model)
                {
                    <tr>
                        <td>@c.Name</td>
                        <td><code>@c.Slug</code></td>
                        <td>@(c.Parent?.Name ?? "-")</td>
                        <td>@c.DisplayOrder</td>
                        <td>@(c.IsActive ? Html.Raw("<span class='badge bg-success'>Aktif</span>") : Html.Raw("<span class='badge bg-secondary'>Pasif</span>"))</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary"><i class="fa-solid fa-pen"></i></a>
                            <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline" onsubmit="return confirm('Silmek istediğinize emin misiniz?');">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
