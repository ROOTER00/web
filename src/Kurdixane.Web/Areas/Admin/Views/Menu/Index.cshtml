@model List<Kurdixane.Web.Models.MenuItem>
@{ ViewData["Title"] = "Menü"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="page-title mb-0">Menü Yönetimi</h1>
    <a asp-action="Create" class="btn btn-primary"><i class="fa-solid fa-plus me-1"></i>Yeni Öğe</a>
</div>
<div class="admin-card"><div class="card-body p-0">
    <table class="table mb-0">
        <thead><tr><th>Başlık</th><th>URL</th><th>Konum</th><th>Sıra</th><th>Durum</th><th></th></tr></thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="6" class="text-center text-muted py-4">Menü öğesi yok.</td></tr>
            }
            @foreach (var m in Model)
            {
                <tr>
                    <td>@m.Title</td>
                    <td><code>@m.Url</code></td>
                    <td>@m.Location</td>
                    <td>@m.DisplayOrder</td>
                    <td>@(m.IsActive ? Html.Raw("<span class='badge bg-success'>Aktif</span>") : Html.Raw("<span class='badge bg-secondary'>Pasif</span>"))</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@m.Id" class="btn btn-sm btn-outline-primary"><i class="fa-solid fa-pen"></i></a>
                        <form asp-action="Delete" asp-route-id="@m.Id" method="post" class="d-inline" onsubmit="return confirm('Emin misiniz?');">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash"></i></button></form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div></div>
