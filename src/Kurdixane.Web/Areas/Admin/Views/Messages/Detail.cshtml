@model Kurdixane.Web.Models.ContactMessage
@{ ViewData["Title"] = "Mesaj"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="page-title mb-0">Mesaj Detayı</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Geri</a>
</div>
<div class="admin-card"><div class="card-body">
    <dl class="row">
        <dt class="col-sm-2">Gönderen</dt><dd class="col-sm-10">@Model.Name</dd>
        <dt class="col-sm-2">E-posta</dt><dd class="col-sm-10">@Model.Email</dd>
        <dt class="col-sm-2">Konu</dt><dd class="col-sm-10">@Model.Subject</dd>
        <dt class="col-sm-2">Tarih</dt><dd class="col-sm-10">@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</dd>
        <dt class="col-sm-2">Mesaj</dt><dd class="col-sm-10">@Model.Message</dd>
    </dl>
</div></div>
