@model Kurdixane.Web.Models.Order
@{
    ViewData["Title"] = "Sipariş Detayı";
    var statuses = Enum.GetValues<Kurdixane.Web.Models.OrderStatus>();
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="page-title mb-0">Sipariş @Model.OrderNumber</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Geri</a>
</div>
<div class="row g-4">
    <div class="col-lg-8">
        <div class="admin-card">
            <div class="card-head"><h5>Ürünler</h5></div>
            <div class="card-body p-0">
                <table class="table mb-0">
                    <thead><tr><th>Ürün</th><th>Birim Fiyat</th><th>Adet</th><th>Toplam</th></tr></thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr><td>@item.ProductName</td><td>@item.UnitPrice.ToString("N2") ₺</td><td>@item.Quantity</td><td>@item.LineTotal.ToString("N2") ₺</td></tr>
                        }
                    </tbody>
                    <tfoot><tr><th colspan="3" class="text-end">Genel Toplam</th><th>@Model.TotalAmount.ToString("N2") ₺</th></tr></tfoot>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="admin-card"><div class="card-head"><h5>Müşteri</h5></div><div class="card-body">
            <p class="mb-1"><strong>@Model.CustomerName</strong></p>
            <p class="mb-1 text-muted">@Model.Email</p>
            <p class="mb-1 text-muted">@Model.Phone</p>
            <hr />
            <p class="mb-1">@Model.Address</p>
            <p class="mb-1">@Model.City</p>
            @if (!string.IsNullOrEmpty(Model.Note))
            {
                <hr /><p class="mb-0"><em>Not: @Model.Note</em></p>
            }
        </div></div>
        <div class="admin-card"><div class="card-head"><h5>Durum</h5></div><div class="card-body">
            <form asp-action="UpdateStatus" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <select name="status" class="form-select mb-2">
                    @foreach (var s in statuses)
                    {
                        <option value="@s" selected="@(s == Model.Status)">@s</option>
                    }
                </select>
                <button type="submit" class="btn btn-primary w-100">Güncelle</button>
            </form>
        </div></div>
    </div>
</div>
