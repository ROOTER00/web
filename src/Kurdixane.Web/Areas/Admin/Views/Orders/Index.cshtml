@model List<Kurdixane.Web.Models.Order>
@{ ViewData["Title"] = "Siparişler"; }
<h1 class="page-title">Siparişler</h1>
<div class="admin-card">
    <div class="card-body p-0">
        <table class="table mb-0">
            <thead><tr><th>Sipariş No</th><th>Müşteri</th><th>Tarih</th><th>Tutar</th><th>Durum</th><th></th></tr></thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">Sipariş bulunmuyor.</td></tr>
                }
                @foreach (var o in Model)
                {
                    <tr>
                        <td>@o.OrderNumber</td>
                        <td>@o.CustomerName<br /><small class="text-muted">@o.Email</small></td>
                        <td>@o.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@o.TotalAmount.ToString("N2") ₺</td>
                        <td><span class="badge bg-secondary">@o.Status</span></td>
                        <td class="text-end"><a asp-action="Detail" asp-route-id="@o.Id" class="btn btn-sm btn-outline-primary">Detay</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
