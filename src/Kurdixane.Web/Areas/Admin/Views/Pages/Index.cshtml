@model List<Kurdixane.Web.Models.Page>
@{ ViewData["Title"] = "Sayfalar"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="page-title mb-0">Sayfalar</h1>
    <a asp-action="Create" class="btn btn-primary"><i class="fa-solid fa-plus me-1"></i>Yeni Sayfa</a>
</div>
<div class="admin-card"><div class="card-body p-0">
    <table class="table mb-0">
        <thead><tr><th>Başlık</th><th>Slug</th><th>Durum</th><th></th></tr></thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="4" class="text-center text-muted py-4">Sayfa yok.</td></tr>
            }
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.Title</td>
                    <td><code>@p.Slug</code></td>
                    <td>@(p.IsActive ? Html.Raw("<span class='badge bg-success'>Aktif</span>") : Html.Raw("<span class='badge bg-secondary'>Pasif</span>"))</td>
                    <td class="text-end">
                        <a asp-area="" asp-controller="Page" asp-action="Index" asp-route-slug="@p.Slug" target="_blank" class="btn btn-sm btn-outline-secondary"><i class="fa-solid fa-eye"></i></a>
                        <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary"><i class="fa-solid fa-pen"></i></a>
                        <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline" onsubmit="return confirm('Emin misiniz?');">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash"></i></button></form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div></div>
