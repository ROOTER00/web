@model List<Kurdixane.Web.Models.Product>
@{
    ViewData["Title"] = "Ürünler";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="page-title mb-0">Ürünler</h1>
    <a asp-action="Create" class="btn btn-primary"><i class="fa-solid fa-plus me-1"></i>Yeni Ürün</a>
</div>
<div class="admin-card">
    <div class="card-body p-0">
        <table class="table mb-0">
            <thead><tr><th></th><th>Ad</th><th>Kategori</th><th>Fiyat</th><th>Stok</th><th>Durum</th><th></th></tr></thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">Henüz ürün yok.</td></tr>
                }
                @foreach (var p in Model)
                {
                    <tr>
                        <td><img src="@(string.IsNullOrEmpty(p.ImageUrl) ? "/img/products/placeholder-1.svg" : p.ImageUrl)" class="thumb-sm" /></td>
                        <td>@p.Name</td>
                        <td>@(p.Category?.Name ?? "-")</td>
                        <td>@p.Price.ToString("N2") ₺</td>
                        <td>@p.Stock</td>
                        <td>@(p.IsActive ? Html.Raw("<span class='badge bg-success'>Aktif</span>") : Html.Raw("<span class='badge bg-secondary'>Pasif</span>"))</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary"><i class="fa-solid fa-pen"></i></a>
                            <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline" onsubmit="return confirm('Silmek istediğinize emin misiniz?');">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
