@model List<Kurdixane.Web.Models.User>
@{ ViewData["Title"] = "Kullanıcılar"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="page-title mb-0">Kullanıcılar</h1>
    <a asp-action="Create" class="btn btn-primary"><i class="fa-solid fa-plus me-1"></i>Yeni Kullanıcı</a>
</div>
<div class="admin-card"><div class="card-body p-0">
    <table class="table mb-0">
        <thead><tr><th>Ad Soyad</th><th>E-posta</th><th>Rol</th><th>Durum</th><th></th></tr></thead>
        <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td>@u.FullName</td>
                    <td>@u.Email</td>
                    <td>@(u.Role == Kurdixane.Web.Models.UserRole.Admin ? Html.Raw("<span class='badge bg-danger'>Admin</span>") : Html.Raw("<span class='badge bg-info'>Müşteri</span>"))</td>
                    <td>@(u.IsActive ? Html.Raw("<span class='badge bg-success'>Aktif</span>") : Html.Raw("<span class='badge bg-secondary'>Pasif</span>"))</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-outline-primary"><i class="fa-solid fa-pen"></i></a>
                        <form asp-action="Delete" asp-route-id="@u.Id" method="post" class="d-inline" onsubmit="return confirm('Emin misiniz?');">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash"></i></button></form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div></div>
