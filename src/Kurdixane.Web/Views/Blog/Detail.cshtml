@model Kurdixane.Web.Models.BlogPost
@{
    ViewData["Title"] = Model.MetaTitle ?? Model.Title;
    ViewData["MetaDescription"] = Model.MetaDescription ?? Model.Summary;
    ViewData["MetaKeywords"] = Model.MetaKeywords;
    var recent = ViewBag.RecentPosts as List<Kurdixane.Web.Models.BlogPost> ?? new();
}
<div class="page-head">
    <div class="container">
        <h1>@Model.Title</h1>
        <nav><ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Anasayfa</a></li>
            <li class="breadcrumb-item"><a asp-controller="Blog" asp-action="Index">Blog</a></li>
            <li class="breadcrumb-item active">@Model.Title</li>
        </ol></nav>
    </div>
</div>
<section class="section">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-8">
                <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/img/blog/post-1.svg" : Model.ImageUrl)" alt="@Model.Title" class="img-fluid rounded mb-4" />
                <div class="blog-meta mb-3">
                    <i class="fa-regular fa-calendar me-1"></i>@((Model.PublishedAt ?? Model.CreatedAt).ToString("dd.MM.yyyy"))
                    @if (!string.IsNullOrEmpty(Model.Author)) { <span class="ms-3"><i class="fa-regular fa-user me-1"></i>@Model.Author</span> }
                </div>
                <div class="blog-content">@Html.Raw(Model.Content)</div>
            </div>
            <aside class="col-lg-4">
                <div class="sidebar-box">
                    <h6>Son Yazılar</h6>
                    <ul class="cat-list">
                        @foreach (var rp in recent)
                        {
                            <li><a asp-controller="Blog" asp-action="Detail" asp-route-slug="@rp.Slug">@rp.Title</a></li>
                        }
                    </ul>
                </div>
            </aside>
        </div>
    </div>
</section>
