@model Kurdixane.Web.ViewModels.BlogListViewModel
@{
    ViewData["Title"] = "Blog";
    var p = Model.Posts;
}

<partial name="_Breadcrumb" />

<div class="rbt-blog-area bg-color-white rbt-section-gap">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-8">
                <div class="row g-4">
                    @if (p.Items.Count == 0)
                    {
                        <p class="rbt-card-text">Henüz yazı bulunmuyor.</p>
                    }
                    @foreach (var post in p.Items)
                    {
                        <div class="col-md-6">
                            <div class="rbt-card variation-02 rbt-hover">
                                <div class="rbt-card-img">
                                    <a asp-controller="Blog" asp-action="Detail" asp-route-slug="@post.Slug">
                                        <img src="@(string.IsNullOrEmpty(post.ImageUrl) ? "/img/blog/post-1.svg" : post.ImageUrl)" alt="@post.Title" />
                                    </a>
                                </div>
                                <div class="rbt-card-body">
                                    <div class="rbt-card-bottom mb--10">
                                        <span class="rbt-meta"><i class="feather-calendar"></i> @((post.PublishedAt ?? post.CreatedAt).ToString("dd.MM.yyyy"))</span>
                                    </div>
                                    <h4 class="rbt-card-title"><a asp-controller="Blog" asp-action="Detail" asp-route-slug="@post.Slug">@post.Title</a></h4>
                                    <p class="rbt-card-text">@post.Summary</p>
                                    <a asp-controller="Blog" asp-action="Detail" asp-route-slug="@post.Slug" class="rbt-btn-link">Devamını Oku <i class="feather-arrow-right"></i></a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                @if (p.TotalPages > 1)
                {
                    <div class="row">
                        <div class="col-lg-12 mt--40">
                            <nav>
                                <ul class="rbt-pagination justify-content-center">
                                    @for (int i = 1; i <= p.TotalPages; i++)
                                    {
                                        <li class="@(i == p.Page ? "active" : "")"><a asp-action="Index" asp-route-page="@i">@i</a></li>
                                    }
                                </ul>
                            </nav>
                        </div>
                    </div>
                }
            </div>
            <aside class="col-lg-4">
                <div class="kx-summary-card">
                    <h5 class="mb--20">Son Yazılar</h5>
                    <ul class="kx-side-list">
                        @foreach (var rp in Model.RecentPosts)
                        {
                            <li><a asp-controller="Blog" asp-action="Detail" asp-route-slug="@rp.Slug"><i class="feather-chevron-right"></i> @rp.Title</a></li>
                        }
                    </ul>
                </div>
            </aside>
        </div>
    </div>
</div>
