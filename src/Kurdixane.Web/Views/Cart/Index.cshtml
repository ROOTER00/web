@model Kurdixane.Web.ViewModels.CartViewModel
@{
    ViewData["Title"] = "Sepetim";
}

<partial name="_Breadcrumb" />

<div class="rbt-cart-area bg-color-white rbt-section-gap">
    <div class="container">
        @if (Model.Lines.Count == 0)
        {
            <div class="text-center py-5">
                <div class="kx-empty-icon mb--20"><i class="feather-shopping-cart"></i></div>
                <h4 class="title">Sepetiniz boş</h4>
                <p class="description">Beğendiğiniz ürünleri sepete ekleyerek alışverişe başlayın.</p>
                <a asp-controller="Product" asp-action="Index" class="rbt-btn btn-gradient mt--10">Alışverişe Başla</a>
            </div>
        }
        else
        {
            <div class="row g-5">
                <div class="col-lg-8">
                    <div class="kx-summary-card">
                        <div class="table-responsive">
                            <table class="kx-cart-table">
                                <thead>
                                    <tr><th>Ürün</th><th>Fiyat</th><th>Adet</th><th>Toplam</th><th></th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var line in Model.Lines)
                                    {
                                        <tr>
                                            <td>
                                                <div class="kx-cart-product">
                                                    <img class="kx-cart-thumb" src="@(string.IsNullOrEmpty(line.ImageUrl) ? "/img/products/placeholder-1.svg" : line.ImageUrl)" alt="@line.Name" />
                                                    <a asp-controller="Product" asp-action="Detail" asp-route-slug="@line.Slug" class="fw-semibold">@line.Name</a>
                                                </div>
                                            </td>
                                            <td>@line.UnitPrice.ToString("N2") ₺</td>
                                            <td>
                                                <form asp-controller="Cart" asp-action="Update" method="post" class="d-flex gap-1">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="productId" value="@line.ProductId" />
                                                    <input type="number" name="quantity" value="@line.Quantity" min="1" class="kx-qty-input form-control form-control-sm" />
                                                    <button class="rbt-btn-link" type="submit" title="Güncelle"><i class="feather-refresh-cw"></i></button>
                                                </form>
                                            </td>
                                            <td class="fw-bold">@line.LineTotal.ToString("N2") ₺</td>
                                            <td>
                                                <form asp-controller="Cart" asp-action="Remove" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="productId" value="@line.ProductId" />
                                                    <button class="rbt-btn-link color-danger" type="submit" title="Kaldır"><i class="feather-trash-2"></i></button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <form asp-controller="Cart" asp-action="Clear" method="post" class="mt--20">
                            @Html.AntiForgeryToken()
                            <button class="rbt-btn-link color-danger" type="submit"><i class="feather-trash-2"></i> Sepeti Temizle</button>
                        </form>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="kx-summary-card">
                        <h4>Sipariş Özeti</h4>
                        <div class="kx-summary-row"><span>Ara Toplam</span><span>@Model.Subtotal.ToString("N2") ₺</span></div>
                        <div class="kx-summary-row"><span>Kargo</span><span>@(Model.ShippingCost == 0 ? "Ücretsiz" : Model.ShippingCost.ToString("N2") + " ₺")</span></div>
                        <div class="kx-summary-total"><span>Toplam</span><span>@Model.Total.ToString("N2") ₺</span></div>
                        <a asp-controller="Checkout" asp-action="Index" class="rbt-btn btn-gradient w-100 mt--20 text-center">Siparişi Tamamla</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
