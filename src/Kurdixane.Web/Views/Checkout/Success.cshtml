@{
    ViewData["Title"] = "Sipariş Alındı";
}

<div class="rbt-elements-area bg-color-white rbt-section-gap">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-7">
                <div class="kx-summary-card text-center">
                    <div class="kx-success-icon mb--20"><i class="feather-check-circle"></i></div>
                    <h2 class="title">Siparişiniz Alındı!</h2>
                    <p class="description">Sipariş numaranız: <strong>@ViewBag.OrderNumber</strong></p>
                    <p class="rbt-card-text">Siparişiniz en kısa sürede hazırlanacaktır. Teşekkür ederiz.</p>
                    <a asp-controller="Home" asp-action="Index" class="rbt-btn btn-gradient mt--10">Anasayfaya Dön</a>
                </div>
            </div>
        </div>
    </div>
</div>
