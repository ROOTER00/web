@model Kurdixane.Web.Models.ContactMessage
@{
    ViewData["Title"] = "İletişim";
    var settings = ViewBag.Settings as Dictionary<string, string?> ?? new();
}

<partial name="_Breadcrumb" />

<div class="rbt-contact-area bg-color-white rbt-section-gap">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-5">
                <div class="kx-summary-card h-100">
                    <h4>İletişim Bilgileri</h4>
                    <div class="kx-contact-item">
                        <span class="kx-contact-ico"><i class="feather-map-pin"></i></span>
                        <span>@settings.GetValueOrDefault("ContactAddress")</span>
                    </div>
                    <div class="kx-contact-item">
                        <span class="kx-contact-ico"><i class="feather-phone"></i></span>
                        <span>@settings.GetValueOrDefault("ContactPhone")</span>
                    </div>
                    <div class="kx-contact-item">
                        <span class="kx-contact-ico"><i class="feather-mail"></i></span>
                        <span>@settings.GetValueOrDefault("ContactEmail")</span>
                    </div>
                </div>
            </div>
            <div class="col-lg-7">
                <div class="rbt-contact-form contact-form-style-1 kx-summary-card">
                    <h4>Bize Yazın</h4>
                    <form asp-controller="Contact" asp-action="Index" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb--10"></div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <input asp-for="Name" type="text" />
                                    <label asp-for="Name">Ad Soyad</label>
                                    <span class="focus-border"></span>
                                    <span asp-validation-for="Name" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <input asp-for="Email" type="email" />
                                    <label asp-for="Email">E-posta</label>
                                    <span class="focus-border"></span>
                                    <span asp-validation-for="Email" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <input asp-for="Subject" type="text" />
                            <label asp-for="Subject">Konu</label>
                            <span class="focus-border"></span>
                        </div>
                        <div class="form-group">
                            <textarea asp-for="Message" rows="5"></textarea>
                            <label asp-for="Message">Mesaj</label>
                            <span class="focus-border"></span>
                            <span asp-validation-for="Message" class="text-danger"></span>
                        </div>
                        <div class="form-submit-group">
                            <button type="submit" class="rbt-btn btn-md btn-gradient hover-icon-reverse">
                                <span class="icon-reverse-wrapper">
                                    <span class="btn-text">Gönder</span>
                                    <span class="btn-icon"><i class="feather-arrow-right"></i></span>
                                    <span class="btn-icon"><i class="feather-arrow-right"></i></span>
                                </span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
