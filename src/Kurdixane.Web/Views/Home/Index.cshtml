@model Kurdixane.Web.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Anasayfa";
    var catIcons = new[] { "fa-wheat-awn", "fa-pepper-hot", "fa-bowl-rice", "fa-mug-hot", "fa-bottle-droplet", "fa-leaf" };
}

@if (Model.Sliders.Any())
{
    <section class="hero-slider">
        <div id="heroCarousel" class="carousel slide" data-bs-ride="carousel">
            <div class="carousel-indicators">
                @for (int i = 0; i < Model.Sliders.Count; i++)
                {
                    <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")"></button>
                }
            </div>
            <div class="carousel-inner">
                @for (int i = 0; i < Model.Sliders.Count; i++)
                {
                    var s = Model.Sliders[i];
                    <div class="carousel-item @(i == 0 ? "active" : "")">
                        <div class="hero-slide" style="background-image:url('@s.ImageUrl')">
                            <div class="container">
                                <div class="hero-content">
                                    <h2>@s.Title</h2>
                                    <p>@s.Subtitle</p>
                                    @if (!string.IsNullOrEmpty(s.Link))
                                    {
                                        <a href="@s.Link" class="btn btn-accent btn-lg">@(string.IsNullOrEmpty(s.ButtonText) ? "İncele" : s.ButtonText)</a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev"><span class="carousel-control-prev-icon"></span></button>
            <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next"><span class="carousel-control-next-icon"></span></button>
        </div>
    </section>
}

<section class="section">
    <div class="container">
        <div class="section-title"><h3>Kategoriler</h3><p>İhtiyacınıza uygun ürün gruplarını keşfedin</p></div>
        <div class="row g-3">
            @{ int ci = 0; }
            @foreach (var cat in Model.Categories)
            {
                <div class="col-6 col-md-4 col-lg-2">
                    <a class="category-card" asp-controller="Category" asp-action="Index" asp-route-slug="@cat.Slug">
                        <div class="cat-icon"><i class="fa-solid @catIcons[ci++ % catIcons.Length]"></i></div>
                        <h6>@cat.Name</h6>
                    </a>
                </div>
            }
        </div>
    </div>
</section>

@if (Model.FeaturedProducts.Any())
{
    <section class="section bg-light-kx">
        <div class="container">
            <div class="section-title"><h3>Öne Çıkan Ürünler</h3><p>En çok tercih edilen ürünlerimiz</p></div>
            <div class="row g-4">
                @foreach (var p in Model.FeaturedProducts)
                {
                    <div class="col-6 col-md-4 col-lg-3"><partial name="_ProductCard" model="p" /></div>
                }
            </div>
        </div>
    </section>
}

@if (Model.LatestProducts.Any())
{
    <section class="section">
        <div class="container">
            <div class="section-title"><h3>Yeni Ürünler</h3><p>Kataloğumuza yeni eklenenler</p></div>
            <div class="row g-4">
                @foreach (var p in Model.LatestProducts)
                {
                    <div class="col-6 col-md-4 col-lg-3"><partial name="_ProductCard" model="p" /></div>
                }
            </div>
            <div class="text-center mt-4">
                <a asp-controller="Product" asp-action="Index" class="btn btn-outline-primary btn-lg">Tüm Ürünler</a>
            </div>
        </div>
    </section>
}

<section class="section bg-light-kx">
    <div class="container">
        <div class="row text-center g-4">
            <div class="col-md-3"><i class="fa-solid fa-truck-fast fa-2x text-primary mb-2"></i><h6>Hızlı Teslimat</h6><p class="text-muted small">Siparişleriniz özenle hazırlanır</p></div>
            <div class="col-md-3"><i class="fa-solid fa-leaf fa-2x text-primary mb-2"></i><h6>%100 Doğal</h6><p class="text-muted small">Doğal ve katkısız ürünler</p></div>
            <div class="col-md-3"><i class="fa-solid fa-shield-halved fa-2x text-primary mb-2"></i><h6>Güvenli Alışveriş</h6><p class="text-muted small">Bilgileriniz güvende</p></div>
            <div class="col-md-3"><i class="fa-solid fa-headset fa-2x text-primary mb-2"></i><h6>Destek</h6><p class="text-muted small">Her zaman yanınızdayız</p></div>
        </div>
    </div>
</section>

@if (Model.RecentPosts.Any())
{
    <section class="section">
        <div class="container">
            <div class="section-title"><h3>Blog</h3><p>Güncel yazılarımız</p></div>
            <div class="row g-4">
                @foreach (var post in Model.RecentPosts)
                {
                    <div class="col-md-4">
                        <article class="blog-card">
                            <a asp-controller="Blog" asp-action="Detail" asp-route-slug="@post.Slug" class="blog-thumb d-block">
                                <img src="@(string.IsNullOrEmpty(post.ImageUrl) ? "/img/blog/post-1.svg" : post.ImageUrl)" alt="@post.Title" />
                            </a>
                            <div class="blog-body">
                                <div class="blog-meta mb-2"><i class="fa-regular fa-calendar me-1"></i>@((post.PublishedAt ?? post.CreatedAt).ToString("dd.MM.yyyy"))</div>
                                <h5><a asp-controller="Blog" asp-action="Detail" asp-route-slug="@post.Slug" class="text-dark">@post.Title</a></h5>
                                <p class="text-muted small">@post.Summary</p>
                            </div>
                        </article>
                    </div>
                }
            </div>
        </div>
    </section>
}
