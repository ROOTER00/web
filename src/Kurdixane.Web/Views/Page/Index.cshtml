@model Kurdixane.Web.Models.Page
@{
    ViewData["Title"] = Model.MetaTitle ?? Model.Title;
    ViewData["MetaDescription"] = Model.MetaDescription;
    ViewData["MetaKeywords"] = Model.MetaKeywords;
}
<div class="page-head">
    <div class="container">
        <h1>@Model.Title</h1>
        <nav><ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Anasayfa</a></li>
            <li class="breadcrumb-item active">@Model.Title</li>
        </ol></nav>
    </div>
</div>
<section class="section">
    <div class="container">
        <div class="page-content">@Html.Raw(Model.Content)</div>
    </div>
</section>
