@model Kurdixane.Web.ViewModels.ProductDetailViewModel
@{
    var pr = Model.Product;
    ViewData["Title"] = pr.MetaTitle ?? pr.Name;
    ViewData["MetaDescription"] = pr.MetaDescription;
    ViewData["MetaKeywords"] = pr.MetaKeywords;
    var crumbs = new List<(string Text, string? Url)>
    {
        ("Ürünler", Url.Action("Index", "Product"))
    };
    if (pr.Category != null)
    {
        crumbs.Add((pr.Category.Name, Url.Action("Index", "Category", new { slug = pr.Category.Slug })));
    }
    crumbs.Add((pr.Name, null));
    ViewData["BcCrumbs"] = crumbs;
    ViewData["BcTitle"] = pr.Name;
    bool onSale = pr.OldPrice.HasValue && pr.OldPrice > pr.Price;
}

<partial name="_Breadcrumb" />

<div class="rbt-course-details-area bg-color-white rbt-section-gap">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-5">
                <div class="kx-detail-gallery">
                    <div class="kx-detail-main">
                        <img src="@(string.IsNullOrEmpty(pr.ImageUrl) ? "/img/products/placeholder-1.svg" : pr.ImageUrl)" alt="@pr.Name" />
                    </div>
                    @if (pr.Images != null && pr.Images.Any())
                    {
                        <div class="row g-2 mt--15">
                            @foreach (var img in pr.Images.OrderBy(i => i.DisplayOrder))
                            {
                                <div class="col-3"><img class="kx-detail-thumb" src="@img.ImageUrl" alt="@img.AltText" /></div>
                            }
                        </div>
                    }
                </div>
            </div>
            <div class="col-lg-7">
                <div class="kx-detail-info">
                    @if (pr.Category != null)
                    {
                        <span class="rbt-badge-2 mb--10"><i class="feather-tag"></i> @pr.Category.Name</span>
                    }
                    <h2 class="title">@pr.Name</h2>
                    @if (!string.IsNullOrEmpty(pr.Sku))
                    {
                        <p class="rbt-card-text">Ürün Kodu: <strong>@pr.Sku</strong></p>
                    }
                    <div class="rbt-price large-size mb--20">
                        <span class="current-price">@pr.Price.ToString("N2") ₺</span>
                        @if (onSale)
                        {
                            <span class="off-price">@pr.OldPrice!.Value.ToString("N2") ₺</span>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(pr.ShortDescription))
                    {
                        <p class="description">@pr.ShortDescription</p>
                    }
                    <div class="mb--20">
                        @if (pr.Stock > 0)
                        {
                            <span class="rbt-badge variation-02 bg-color-success-opacity color-success"><i class="feather-check"></i> Stokta (@pr.Stock)</span>
                        }
                        else
                        {
                            <span class="rbt-badge variation-02 bg-color-danger-opacity color-danger">Stokta Yok</span>
                        }
                    </div>
                    <form asp-controller="Cart" asp-action="Add" method="post" class="d-flex gap-3 align-items-center flex-wrap">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="productId" value="@pr.Id" />
                        <input type="number" name="quantity" value="1" min="1" class="kx-qty-input form-control" />
                        <button type="submit" class="rbt-btn btn-gradient hover-icon-reverse" @(pr.Stock <= 0 ? "disabled" : "")>
                            <div class="icon-reverse-wrapper">
                                <span class="btn-text"><i class="feather-shopping-cart"></i> Sepete Ekle</span>
                                <span class="btn-icon"><i class="feather-arrow-right"></i></span>
                                <span class="btn-icon"><i class="feather-arrow-right"></i></span>
                            </div>
                        </button>
                    </form>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(pr.Description))
        {
            <div class="row mt--50">
                <div class="col-12">
                    <div class="rbt-course-feature-box rbt-shadow-box p-4 p-md-5">
                        <h4 class="rbt-title-style-3 mb--20">Ürün Açıklaması</h4>
                        <div class="kx-rte">@Html.Raw(pr.Description)</div>
                    </div>
                </div>
            </div>
        }

        @if (Model.RelatedProducts.Any())
        {
            <div class="mt--50">
                <div class="section-title mb--30">
                    <h3 class="title">Benzer Ürünler</h3>
                </div>
                <div class="row g-4">
                    @foreach (var rp in Model.RelatedProducts)
                    {
                        <div class="col-lg-3 col-md-4 col-sm-6 col-12"><partial name="_ProductCard" model="rp" /></div>
                    }
                </div>
            </div>
        }
    </div>
</div>
