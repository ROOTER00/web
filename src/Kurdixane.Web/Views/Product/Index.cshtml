@model Kurdixane.Web.ViewModels.ProductListViewModel
@{
    ViewData["Title"] = Model.CurrentCategory?.Name ?? (string.IsNullOrEmpty(Model.Search) ? "Ürünler" : $"Arama: {Model.Search}");
    var p = Model.Products;
    string listController = string.IsNullOrEmpty(Model.CategorySlug) ? "Product" : "Category";
}

<partial name="_Breadcrumb" />

<div class="rbt-course-area bg-color-white rbt-section-gap">
    <div class="container">
        <div class="row g-5">
            <aside class="col-lg-3 order-2 order-lg-1">
                <div class="kx-summary-card mb--30">
                    <h4>Kategoriler</h4>
                    <ul class="rbt-list-style-1">
                        <li><a asp-controller="Product" asp-action="Index" class="@(string.IsNullOrEmpty(Model.CategorySlug) ? "fw-bold" : "")"><i class="feather-chevron-right"></i> Tümü</a></li>
                        @foreach (var cat in Model.Categories)
                        {
                            <li><a asp-controller="Category" asp-action="Index" asp-route-slug="@cat.Slug" class="@(Model.CategorySlug == cat.Slug ? "fw-bold" : "")"><i class="feather-chevron-right"></i> @cat.Name</a></li>
                        }
                    </ul>
                </div>
                <div class="kx-summary-card">
                    <h4>Ürün Ara</h4>
                    <form asp-controller="Product" asp-action="Index" method="get">
                        <div class="rbt-search-style">
                            <input type="search" name="search" value="@Model.Search" placeholder="Ara..." />
                            <button class="rbt-search-btn" type="submit"><i class="feather-search"></i></button>
                        </div>
                    </form>
                </div>
            </aside>
            <div class="col-lg-9 order-1 order-lg-2">
                <div class="rbt-sorting-list d-flex justify-content-between align-items-center mb--30 flex-wrap">
                    <div class="rbt-short-item">
                        <span class="rbt-result-count">@p.TotalCount ürün bulundu</span>
                    </div>
                </div>
                @if (p.Items.Count == 0)
                {
                    <div class="alert alert-info">Bu kritere uygun ürün bulunamadı.</div>
                }
                else
                {
                    <div class="row g-4">
                        @foreach (var product in p.Items)
                        {
                            <div class="col-lg-4 col-md-6 col-sm-6 col-12"><partial name="_ProductCard" model="product" /></div>
                        }
                    </div>

                    @if (p.TotalPages > 1)
                    {
                        <nav class="mt--40">
                            <ul class="rbt-pagination justify-content-center">
                                <li class="@(p.HasPrevious ? "" : "disabled")">
                                    <a asp-action="Index" asp-controller="@listController" asp-route-slug="@Model.CategorySlug" asp-route-search="@Model.Search" asp-route-page="@(p.Page - 1)"><i class="feather-chevron-left"></i></a>
                                </li>
                                @for (int i = 1; i <= p.TotalPages; i++)
                                {
                                    <li class="@(i == p.Page ? "active" : "")">
                                        <a asp-action="Index" asp-controller="@listController" asp-route-slug="@Model.CategorySlug" asp-route-search="@Model.Search" asp-route-page="@i">@i</a>
                                    </li>
                                }
                                <li class="@(p.HasNext ? "" : "disabled")">
                                    <a asp-action="Index" asp-controller="@listController" asp-route-slug="@Model.CategorySlug" asp-route-search="@Model.Search" asp-route-page="@(p.Page + 1)"><i class="feather-chevron-right"></i></a>
                                </li>
                            </ul>
                        </nav>
                    }
                }
            </div>
        </div>
    </div>
</div>
