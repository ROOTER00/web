@model Kurdixane.Web.ViewModels.ProductListViewModel
@{
    ViewData["Title"] = Model.CurrentCategory?.Name ?? (string.IsNullOrEmpty(Model.Search) ? "Ürünler" : $"Arama: {Model.Search}");
    var p = Model.Products;
}

<div class="page-head">
    <div class="container">
        <h1>@ViewData["Title"]</h1>
        <nav>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Anasayfa</a></li>
                <li class="breadcrumb-item active">@ViewData["Title"]</li>
            </ol>
        </nav>
    </div>
</div>

<section class="section">
    <div class="container">
        <div class="row">
            <aside class="col-lg-3">
                <div class="sidebar-box">
                    <h6>Kategoriler</h6>
                    <ul class="cat-list">
                        <li><a asp-controller="Product" asp-action="Index" class="@(string.IsNullOrEmpty(Model.CategorySlug) ? "active" : "")">Tümü</a></li>
                        @foreach (var cat in Model.Categories)
                        {
                            <li><a asp-controller="Category" asp-action="Index" asp-route-slug="@cat.Slug" class="@(Model.CategorySlug == cat.Slug ? "active" : "")">@cat.Name</a></li>
                        }
                    </ul>
                </div>
                <div class="sidebar-box">
                    <h6>Ürün Ara</h6>
                    <form asp-controller="Product" asp-action="Index" method="get">
                        <div class="input-group">
                            <input class="form-control" type="search" name="search" value="@Model.Search" placeholder="Ara..." />
                            <button class="btn btn-primary" type="submit"><i class="fa-solid fa-magnifying-glass"></i></button>
                        </div>
                    </form>
                </div>
            </aside>
            <div class="col-lg-9">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="text-muted">@p.TotalCount ürün bulundu</span>
                </div>
                @if (p.Items.Count == 0)
                {
                    <div class="alert alert-info">Bu kritere uygun ürün bulunamadı.</div>
                }
                else
                {
                    <div class="row g-4">
                        @foreach (var product in p.Items)
                        {
                            <div class="col-6 col-md-4"><partial name="_ProductCard" model="product" /></div>
                        }
                    </div>

                    @if (p.TotalPages > 1)
                    {
                        <nav class="mt-4">
                            <ul class="pagination justify-content-center">
                                <li class="page-item @(p.HasPrevious ? "" : "disabled")">
                                    <a class="page-link" asp-action="Index" asp-controller="@(string.IsNullOrEmpty(Model.CategorySlug) ? "Product" : "Category")" asp-route-slug="@Model.CategorySlug" asp-route-category="@Model.CategorySlug" asp-route-search="@Model.Search" asp-route-page="@(p.Page - 1)">Önceki</a>
                                </li>
                                @for (int i = 1; i <= p.TotalPages; i++)
                                {
                                    <li class="page-item @(i == p.Page ? "active" : "")">
                                        <a class="page-link" asp-action="Index" asp-controller="@(string.IsNullOrEmpty(Model.CategorySlug) ? "Product" : "Category")" asp-route-slug="@Model.CategorySlug" asp-route-category="@Model.CategorySlug" asp-route-search="@Model.Search" asp-route-page="@i">@i</a>
                                    </li>
                                }
                                <li class="page-item @(p.HasNext ? "" : "disabled")">
                                    <a class="page-link" asp-action="Index" asp-controller="@(string.IsNullOrEmpty(Model.CategorySlug) ? "Product" : "Category")" asp-route-slug="@Model.CategorySlug" asp-route-category="@Model.CategorySlug" asp-route-search="@Model.Search" asp-route-page="@(p.Page + 1)">Sonraki</a>
                                </li>
                            </ul>
                        </nav>
                    }
                }
            </div>
        </div>
    </div>
</section>
