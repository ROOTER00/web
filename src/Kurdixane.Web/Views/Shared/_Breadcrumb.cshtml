@{
    string title = ViewData["BcTitle"] as string ?? ViewData["Title"] as string ?? "";
    var crumbs = ViewData["BcCrumbs"] as List<(string Text, string? Url)>;
}
<!-- Start Breadcrumb Area -->
<div class="rbt-breadcrumb-default ptb--100 ptb_md--50 ptb_sm--30 bg-gradient-1">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="breadcrumb-inner text-center">
                    <h2 class="title">@title</h2>
                    <ul class="page-list">
                        <li class="rbt-breadcrumb-item"><a asp-controller="Home" asp-action="Index">Anasayfa</a></li>
                        @if (crumbs != null)
                        {
                            foreach (var c in crumbs)
                            {
                                <li><div class="icon-right"><i class="feather-chevron-right"></i></div></li>
                                @if (!string.IsNullOrEmpty(c.Url))
                                {
                                    <li class="rbt-breadcrumb-item"><a href="@c.Url">@c.Text</a></li>
                                }
                                else
                                {
                                    <li class="rbt-breadcrumb-item active">@c.Text</li>
                                }
                            }
                        }
                        else
                        {
                            <li><div class="icon-right"><i class="feather-chevron-right"></i></div></li>
                            <li class="rbt-breadcrumb-item active">@title</li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- End Breadcrumb Area -->
