@model Kurdixane.Web.ViewModels.FooterViewModel
@using Kurdixane.Web.Models
@{
    string siteTitle = Model.Settings.GetValueOrDefault("SiteTitle") ?? "Kurdixane";
    string footerText = Model.Settings.GetValueOrDefault("FooterText") ?? "Geleneksel lezzetler, modern dokunuş. Doğal ve yöresel ürünleri kapınıza getiriyoruz.";
    string? phone = Model.Settings.GetValueOrDefault("ContactPhone");
    string? email = Model.Settings.GetValueOrDefault("ContactEmail");
    string? address = Model.Settings.GetValueOrDefault("ContactAddress");
    string? facebook = Model.Settings.GetValueOrDefault("Facebook");
    string? twitter = Model.Settings.GetValueOrDefault("Twitter");
    string? instagram = Model.Settings.GetValueOrDefault("Instagram");
    string? linkedin = Model.Settings.GetValueOrDefault("Linkedin");
    var corporate = Model.Menu.Where(m => m.IsActive).OrderBy(m => m.DisplayOrder).ToList();
}

<!-- Start Footer aera -->
<footer class="rbt-footer footer-style-1 bg-color-white overflow-hidden">
    <div class="footer-top">
        <div class="container">
            <div class="row g-5">
                <div class="col-lg-4 col-md-6 col-sm-6 col-12">
                    <div class="footer-widget">
                        <div class="logo">
                            <a href="/"><span class="logo-text">@siteTitle</span></a>
                        </div>
                        <p class="description mt--20">@footerText</p>
                        <ul class="social-icon social-default justify-content-start">
                            <li><a href="@(string.IsNullOrWhiteSpace(facebook) ? "#" : facebook)"><i class="feather-facebook"></i></a></li>
                            <li><a href="@(string.IsNullOrWhiteSpace(twitter) ? "#" : twitter)"><i class="feather-twitter"></i></a></li>
                            <li><a href="@(string.IsNullOrWhiteSpace(instagram) ? "#" : instagram)"><i class="feather-instagram"></i></a></li>
                            <li><a href="@(string.IsNullOrWhiteSpace(linkedin) ? "#" : linkedin)"><i class="feather-linkedin"></i></a></li>
                        </ul>
                        <div class="contact-btn mt--30">
                            <a class="rbt-btn hover-icon-reverse btn-border-gradient radius-round" href="/Contact">
                                <div class="icon-reverse-wrapper">
                                    <span class="btn-text">Bizimle İletişime Geçin</span>
                                    <span class="btn-icon"><i class="feather-arrow-right"></i></span>
                                    <span class="btn-icon"><i class="feather-arrow-right"></i></span>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>

                <div class="col-lg-2 col-md-6 col-sm-6 col-12">
                    <div class="footer-widget">
                        <h5 class="ft-title">Kategoriler</h5>
                        <ul class="ft-link">
                            @foreach (var cat in Model.Categories.OrderBy(c => c.DisplayOrder))
                            {
                                <li><a href="/Category/@cat.Slug">@cat.Name</a></li>
                            }
                        </ul>
                    </div>
                </div>

                <div class="col-lg-2 col-md-6 col-sm-6 col-12">
                    <div class="footer-widget">
                        <h5 class="ft-title">Kurumsal</h5>
                        <ul class="ft-link">
                            @if (corporate.Any())
                            {
                                foreach (var item in corporate)
                                {
                                    <li><a href="@item.Url">@item.Title</a></li>
                                }
                            }
                            else
                            {
                                <li><a href="/Page/hakkimizda">Hakkımızda</a></li>
                                <li><a href="/Blog">Blog</a></li>
                                <li><a href="/Contact">İletişim</a></li>
                                <li><a href="/Page/gizlilik-politikasi">Gizlilik Politikası</a></li>
                            }
                        </ul>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6 col-sm-6 col-12">
                    <div class="footer-widget">
                        <h5 class="ft-title">İletişim</h5>
                        <ul class="ft-link">
                            @if (!string.IsNullOrWhiteSpace(phone))
                            {
                                <li><span>Telefon:</span> <a href="tel:@phone">@phone</a></li>
                            }
                            @if (!string.IsNullOrWhiteSpace(email))
                            {
                                <li><span>E-posta:</span> <a href="mailto:@email">@email</a></li>
                            }
                            @if (!string.IsNullOrWhiteSpace(address))
                            {
                                <li><span>Adres:</span> @address</li>
                            }
                        </ul>

                        <form class="newsletter-form mt--20" method="post" action="/Home/Subscribe">
                            @Html.AntiForgeryToken()
                            <h6 class="w-600">Bülten</h6>
                            <p class="description">Kampanya ve yeni ürünlerden ilk siz haberdar olun.</p>
                            <div class="form-group right-icon icon-email mb--20">
                                <label for="newsletter-email">E-posta adresinizi girin</label>
                                <input id="newsletter-email" name="email" type="email">
                            </div>
                            <div class="form-group mb--0">
                                <button class="rbt-btn rbt-switch-btn btn-gradient radius-round btn-sm" type="submit">
                                    <span data-text="Abone Ol">Abone Ol</span>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="rbt-separator-mid">
        <div class="container">
            <hr class="rbt-separator m-0">
        </div>
    </div>
    <!-- Start Copyright Area  -->
    <div class="copyright-area copyright-style-1 ptb--20">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-xxl-6 col-xl-6 col-lg-6 col-md-12 col-12">
                    <p class="rbt-link-hover text-center text-lg-start">Copyright © @DateTime.Now.Year <a href="/">@siteTitle</a>. Tüm hakları saklıdır.</p>
                </div>
                <div class="col-xxl-6 col-xl-6 col-lg-6 col-md-12 col-12">
                    <ul class="copyright-link rbt-link-hover justify-content-center justify-content-lg-end mt_sm--10 mt_md--10">
                        <li><a href="/Page/gizlilik-politikasi">Gizlilik Politikası</a></li>
                        <li><a href="/Contact">İletişim</a></li>
                        <li><a href="/Account/Login">Giriş & Kayıt</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
    <!-- End Copyright Area  -->
</footer>
<!-- End Footer aera -->
