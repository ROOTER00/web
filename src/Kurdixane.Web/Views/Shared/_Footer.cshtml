@model Kurdixane.Web.ViewModels.FooterViewModel
@{
    string siteTitle = Model.Settings.GetValueOrDefault("SiteTitle") ?? "Kurdixane";
    string footerText = Model.Settings.GetValueOrDefault("FooterText") ?? "";
    string slogan = Model.Settings.GetValueOrDefault("SiteSlogan") ?? "";
    string email = Model.Settings.GetValueOrDefault("ContactEmail") ?? "";
    string phone = Model.Settings.GetValueOrDefault("ContactPhone") ?? "";
    string address = Model.Settings.GetValueOrDefault("ContactAddress") ?? "";
    string fb = Model.Settings.GetValueOrDefault("FacebookUrl") ?? "#";
    string ig = Model.Settings.GetValueOrDefault("InstagramUrl") ?? "#";
    string tw = Model.Settings.GetValueOrDefault("TwitterUrl") ?? "#";
}
<!-- Start Footer Area -->
<footer class="rbt-footer footer-style-1 bg-color-white overflow-hidden">
    <div class="footer-top">
        <div class="container">
            <div class="row row--15 mt_dec--30">
                <div class="col-lg-4 col-md-6 col-sm-6 col-12">
                    <div class="footer-widget">
                        <div class="logo">
                            <a asp-controller="Home" asp-action="Index"><span class="rbt-brand-text">@siteTitle</span></a>
                        </div>
                        <p class="description mt--20">@slogan</p>
                        <div class="contact-btn mt--30">
                            <a class="rbt-btn hover-icon-reverse btn-border-gradient radius-round" asp-controller="Contact" asp-action="Index">
                                <div class="icon-reverse-wrapper">
                                    <span class="btn-text">Bizimle İletişime Geçin</span>
                                    <span class="btn-icon"><i class="feather-arrow-right"></i></span>
                                    <span class="btn-icon"><i class="feather-arrow-right"></i></span>
                                </div>
                            </a>
                        </div>
                        <ul class="social-icon social-default justify-content-start mt--30">
                            <li><a href="@fb"><i class="feather-facebook"></i></a></li>
                            <li><a href="@tw"><i class="feather-twitter"></i></a></li>
                            <li><a href="@ig"><i class="feather-instagram"></i></a></li>
                        </ul>
                    </div>
                </div>

                <div class="col-lg-2 col-md-6 col-sm-6 col-12">
                    <div class="footer-widget">
                        <h5 class="ft-title">Kategoriler</h5>
                        <ul class="ft-link">
                            @foreach (var cat in Model.Categories.Take(6))
                            {
                                <li><a asp-controller="Category" asp-action="Index" asp-route-slug="@cat.Slug">@cat.Name</a></li>
                            }
                        </ul>
                    </div>
                </div>

                <div class="col-lg-2 col-md-6 col-sm-6 col-12">
                    <div class="footer-widget">
                        <h5 class="ft-title">Kurumsal</h5>
                        <ul class="ft-link">
                            @foreach (var item in Model.Menu)
                            {
                                <li><a href="@item.Url">@item.Title</a></li>
                            }
                            <li><a asp-controller="Blog" asp-action="Index">Blog</a></li>
                            <li><a asp-controller="Contact" asp-action="Index">İletişim</a></li>
                        </ul>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6 col-sm-6 col-12">
                    <div class="footer-widget">
                        <h5 class="ft-title">İletişim</h5>
                        <ul class="ft-link">
                            @if (!string.IsNullOrEmpty(phone))
                            {
                                <li><span>Telefon:</span> <a href="tel:@phone">@phone</a></li>
                            }
                            @if (!string.IsNullOrEmpty(email))
                            {
                                <li><span>E-posta:</span> <a href="mailto:@email">@email</a></li>
                            }
                            @if (!string.IsNullOrEmpty(address))
                            {
                                <li><span>Adres:</span> @address</li>
                            }
                        </ul>
                        <form class="newsletter-form-1 mt--20" asp-controller="Contact" asp-action="Index" method="get">
                            <div class="form-group">
                                <input type="email" name="newsletter" placeholder="E-posta adresiniz">
                            </div>
                            <div class="form-group">
                                <button type="submit" class="rbt-btn btn-md btn-gradient w-100">Abone Ol</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</footer>
<!-- End Footer Area -->

<!-- Start Copyright Area -->
<div class="rbt-separator-mid">
    <div class="container">
        <hr class="rbt-separator m-0">
    </div>
</div>
<div class="copyright-area copyright-style-1 ptb--20">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 col-md-8 col-sm-12 col-12">
                <div class="copyright-left text-center text-lg-start">
                    <p class="rbt-link-hover">@(string.IsNullOrEmpty(footerText) ? $"Copyright © {DateTime.Now.Year} {siteTitle}. Tüm hakları saklıdır." : footerText)</p>
                </div>
            </div>
            <div class="col-lg-6 col-md-4 col-sm-12 col-12">
                <div class="copyright-right text-center text-lg-end">
                    <ul class="copyright-link">
                        <li><a asp-controller="Product" asp-action="Index">Ürünler</a></li>
                        <li><a asp-controller="Blog" asp-action="Index">Blog</a></li>
                        <li><a asp-controller="Contact" asp-action="Index">İletişim</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- End Copyright Area -->
