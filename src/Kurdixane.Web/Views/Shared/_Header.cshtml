@model Kurdixane.Web.ViewModels.HeaderViewModel
@{
    string siteTitle = Model.Settings.GetValueOrDefault("SiteTitle") ?? "Kurdixane";
    string phone = Model.Settings.GetValueOrDefault("ContactPhone") ?? "";
    string email = Model.Settings.GetValueOrDefault("ContactEmail") ?? "";
    string slogan = Model.Settings.GetValueOrDefault("SiteSlogan") ?? "";
    bool isAuth = User.Identity?.IsAuthenticated ?? false;
    bool isAdmin = User.IsInRole("Admin");
}

@functions {
    void RenderMenu(IEnumerable<Kurdixane.Web.Models.MenuItem> items)
    {
        foreach (var item in items)
        {
            var children = item.Children;
            if (children != null && children.Count > 0)
            {
                <li class="has-dropdown has-menu-child-item">
                    <a href="@item.Url">@item.Title <i class="feather-chevron-down"></i></a>
                    <ul class="submenu">
                        @{ RenderMenu(children); }
                    </ul>
                </li>
            }
            else
            {
                <li><a href="@item.Url">@item.Title</a></li>
            }
        }
    }
}

<!-- Start Header Area -->
<header class="rbt-header rbt-header-10">
    <div class="rbt-sticky-placeholder"></div>
    <div class="rbt-header-wrapper header-not-transparent header-sticky">
        <div class="container">
            <div class="mainbar-row rbt-navigation-center align-items-center">
                <div class="header-left rbt-header-content">
                    <div class="header-info">
                        <div class="logo">
                            <a asp-controller="Home" asp-action="Index">
                                <span class="rbt-brand-text">@siteTitle</span>
                            </a>
                        </div>
                    </div>
                </div>
                <div class="rbt-main-navigation d-none d-xl-block">
                    <nav class="mainmenu-nav">
                        <ul class="mainmenu">
                            @{ RenderMenu(Model.Menu); }
                            @if (Model.Categories.Any())
                            {
                                <li class="has-dropdown has-menu-child-item">
                                    <a asp-controller="Product" asp-action="Index">Kategoriler <i class="feather-chevron-down"></i></a>
                                    <ul class="submenu">
                                        @foreach (var cat in Model.Categories)
                                        {
                                            <li><a asp-controller="Category" asp-action="Index" asp-route-slug="@cat.Slug">@cat.Name</a></li>
                                        }
                                    </ul>
                                </li>
                            }
                        </ul>
                    </nav>
                </div>
                <div class="header-right">
                    <ul class="quick-access">
                        <li class="access-icon">
                            <a class="search-trigger-active rbt-round-btn" href="javascript:void(0)"><i class="feather-search"></i></a>
                        </li>
                        <li class="access-icon rbt-mini-cart">
                            <a class="rbt-round-btn" asp-controller="Cart" asp-action="Index">
                                <i class="feather-shopping-cart"></i>
                                <span class="rbt-cart-count" id="cartCount">@Model.CartItemCount</span>
                            </a>
                        </li>
                        @if (isAuth)
                        {
                            <li class="account-access rbt-user-wrapper d-none d-xl-block">
                                <a href="javascript:void(0)"><i class="feather-user"></i> @User.GetDisplayName()</a>
                                <div class="rbt-user-menu-list-wrapper">
                                    <div class="inner">
                                        <ul class="user-list-wrapper">
                                            <li>
                                                <a asp-controller="Account" asp-action="Profile"><i class="feather-user"></i><span>Profilim</span></a>
                                            </li>
                                            @if (isAdmin)
                                            {
                                                <li>
                                                    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="feather-grid"></i><span>Admin Panel</span></a>
                                                </li>
                                            }
                                        </ul>
                                        <hr class="mt--10 mb--10">
                                        <ul class="user-list-wrapper">
                                            <li>
                                                <form asp-controller="Account" asp-action="Logout" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="rbt-logout-btn"><i class="feather-log-out"></i><span>Çıkış Yap</span></button>
                                                </form>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>

                    <div class="rbt-btn-wrapper d-none d-xl-block">
                        @if (isAuth)
                        {
                            <a class="rbt-btn btn-gradient radius-round btn-sm hover-icon-reverse" asp-controller="Product" asp-action="Index">
                                <span class="icon-reverse-wrapper">
                                    <span class="btn-text">Alışverişe Başla</span>
                                    <span class="btn-icon"><i class="feather-arrow-right"></i></span>
                                    <span class="btn-icon"><i class="feather-arrow-right"></i></span>
                                </span>
                            </a>
                        }
                        else
                        {
                            <a class="rbt-btn btn-gradient radius-round btn-sm hover-icon-reverse" asp-controller="Account" asp-action="Login">
                                <span class="icon-reverse-wrapper">
                                    <span class="btn-text">Giriş Yap</span>
                                    <span class="btn-icon"><i class="feather-arrow-right"></i></span>
                                    <span class="btn-icon"><i class="feather-arrow-right"></i></span>
                                </span>
                            </a>
                        }
                    </div>

                    <!-- Mobile Menu Bar -->
                    <div class="mobile-menu-bar d-block d-xl-none">
                        <div class="hamberger">
                            <button class="hamberger-button rbt-round-btn">
                                <i class="feather-menu"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Search Dropdown -->
    <div class="rbt-search-dropdown">
        <div class="wrapper">
            <div class="row">
                <div class="col-lg-12">
                    <form asp-controller="Product" asp-action="Index" method="get">
                        <input type="text" name="search" placeholder="Ne aramıştınız?">
                        <div class="submit-btn">
                            <button class="rbt-btn btn-gradient btn-md" type="submit">Ara</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</header>
<!-- End Header Area -->

<!-- Start Mobile Popup Menu -->
<div class="popup-mobile-menu">
    <div class="inner-wrapper">
        <div class="inner-top">
            <div class="content">
                <div class="logo">
                    <a asp-controller="Home" asp-action="Index"><span class="rbt-brand-text">@siteTitle</span></a>
                </div>
                <div class="rbt-btn-close">
                    <button class="close-button rbt-round-btn"><i class="feather-x"></i></button>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(slogan))
            {
                <p class="description">@slogan</p>
            }
            <ul class="navbar-top-left rbt-information-list justify-content-start">
                @if (!string.IsNullOrEmpty(email))
                {
                    <li><a href="mailto:@email"><i class="feather-mail"></i>@email</a></li>
                }
                @if (!string.IsNullOrEmpty(phone))
                {
                    <li><a href="tel:@phone"><i class="feather-phone"></i>@phone</a></li>
                }
            </ul>
        </div>
        <nav class="mainmenu-nav">
            <ul class="mainmenu">
                @{ RenderMenu(Model.Menu); }
                @if (Model.Categories.Any())
                {
                    <li class="has-dropdown has-menu-child-item">
                        <a asp-controller="Product" asp-action="Index">Kategoriler <i class="feather-chevron-down"></i></a>
                        <ul class="submenu">
                            @foreach (var cat in Model.Categories)
                            {
                                <li><a asp-controller="Category" asp-action="Index" asp-route-slug="@cat.Slug">@cat.Name</a></li>
                            }
                        </ul>
                    </li>
                }
                @if (isAuth)
                {
                    <li><a asp-controller="Account" asp-action="Profile">Profilim</a></li>
                    @if (isAdmin)
                    {
                        <li><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin Panel</a></li>
                    }
                }
                else
                {
                    <li><a asp-controller="Account" asp-action="Login">Giriş Yap</a></li>
                    <li><a asp-controller="Account" asp-action="Register">Kayıt Ol</a></li>
                }
            </ul>
        </nav>
    </div>
</div>
<!-- End Mobile Popup Menu -->
