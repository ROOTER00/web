@model Kurdixane.Web.ViewModels.HeaderViewModel
@{
    string siteTitle = Model.Settings.GetValueOrDefault("SiteTitle") ?? "Kurdixane";
    string slogan = Model.Settings.GetValueOrDefault("SiteSlogan") ?? "";
    string phone = Model.Settings.GetValueOrDefault("ContactPhone") ?? "";
    bool isAuth = User.Identity?.IsAuthenticated ?? false;
    bool isAdmin = User.IsInRole("Admin");
}
<div class="topbar d-none d-md-block">
    <div class="container d-flex justify-content-between align-items-center">
        <span><i class="fa-solid fa-phone me-1"></i> @phone</span>
        <span>@slogan</span>
        <span class="topbar-links">
            @if (isAuth)
            {
                @if (isAdmin)
                {
                    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="fa-solid fa-gauge me-1"></i>Admin Panel</a>
                }
                <a asp-controller="Account" asp-action="Profile"><i class="fa-solid fa-user me-1"></i>@User.GetDisplayName()</a>
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline logout-form">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-link-plain">Çıkış</button>
                </form>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login"><i class="fa-solid fa-right-to-bracket me-1"></i>Giriş</a>
                <a asp-controller="Account" asp-action="Register">Kayıt Ol</a>
            }
        </span>
    </div>
</div>

<header class="main-header">
    <div class="container">
        <nav class="navbar navbar-expand-lg">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark">@siteTitle</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav mx-auto">
                    @foreach (var item in Model.Menu)
                    {
                        if (item.Children != null && item.Children.Count > 0)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="@item.Url" data-bs-toggle="dropdown">@item.Title</a>
                                <ul class="dropdown-menu">
                                    @foreach (var child in item.Children)
                                    {
                                        <li><a class="dropdown-item" href="@child.Url">@child.Title</a></li>
                                    }
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" href="@item.Url">@item.Title</a></li>
                        }
                    }
                </ul>
                <form class="header-search d-flex" asp-controller="Product" asp-action="Index" method="get">
                    <input class="form-control" type="search" name="search" placeholder="Ürün ara..." />
                    <button class="btn btn-search" type="submit"><i class="fa-solid fa-magnifying-glass"></i></button>
                </form>
                <a class="cart-link" asp-controller="Cart" asp-action="Index">
                    <i class="fa-solid fa-cart-shopping"></i>
                    <span class="cart-count" id="cartCount">@Model.CartItemCount</span>
                </a>
            </div>
        </nav>
    </div>
</header>
