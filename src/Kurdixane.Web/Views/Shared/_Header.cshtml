@model Kurdixane.Web.ViewModels.HeaderViewModel
@using Kurdixane.Web.Models
@{
    string siteTitle = Model.Settings.GetValueOrDefault("SiteTitle") ?? "Kurdixane";

    void RenderMenu(List<MenuItem> items)
    {
        foreach (var item in items.OrderBy(i => i.DisplayOrder))
        {
            var children = item.Children?.Where(c => c.IsActive).OrderBy(c => c.DisplayOrder).ToList() ?? new List<MenuItem>();
            if (children.Any())
            {
                <li class="has-dropdown has-menu-child-item">
                    <a href="@item.Url">@item.Title <i class="feather-chevron-down"></i></a>
                    <ul class="submenu">
                        @{ RenderMenu(children); }
                    </ul>
                </li>
            }
            else
            {
                <li><a href="@item.Url">@item.Title</a></li>
            }
        }
    }
}

<!-- Start Header Area -->
<header class="rbt-header rbt-header-10">
    <div class="rbt-sticky-placeholder"></div>
    <div class="rbt-header-wrapper header-space-betveen header-sticky">
        <div class="container-fluid">
            <div class="mainbar-row rbt-navigation-center align-items-center">
                <div class="header-left rbt-header-content">
                    <div class="header-info">
                        <div class="logo">
                            <a href="/"><span class="logo-text">@siteTitle</span></a>
                        </div>
                    </div>
                </div>

                <div class="rbt-main-navigation d-none d-xl-block">
                    <nav class="mainmenu-nav">
                        <ul class="mainmenu">
                            @{ RenderMenu(Model.Menu); }
                            @if (Model.Categories.Any())
                            {
                                <li class="with-megamenu has-menu-child-item position-static">
                                    <a href="/Product">Kategoriler <i class="feather-chevron-down"></i></a>
                                    <div class="rbt-megamenu">
                                        <div class="wrapper">
                                            <div class="row row--15">
                                                <div class="col-lg-12 single-mega-item">
                                                    <ul class="mega-menu-item">
                                                        @foreach (var cat in Model.Categories.OrderBy(c => c.DisplayOrder))
                                                        {
                                                            <li><a href="/Category/@cat.Slug"><span class="menu-item">@cat.Name</span></a></li>
                                                        }
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </li>
                            }
                        </ul>
                    </nav>
                </div>

                <div class="header-right">
                    <ul class="quick-access">
                        <li class="access-icon">
                            <a class="search-trigger-active rbt-round-btn" href="javascript:void(0)">
                                <i class="feather-search"></i>
                            </a>
                        </li>
                        <li class="access-icon rbt-mini-cart">
                            <a class="rbt-cart-sidenav-activation rbt-round-btn" href="/Cart">
                                <i class="feather-shopping-cart"></i>
                                <span class="rbt-cart-count">@Model.CartItemCount</span>
                            </a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="account-access rbt-user-wrapper d-none d-xl-block">
                                <a href="/Account/Profile"><i class="feather-user"></i>@(User.Identity?.Name)</a>
                                <div class="rbt-user-menu-list-wrapper">
                                    <div class="inner">
                                        <ul class="user-list-wrapper">
                                            <li><a href="/Account/Profile"><i class="feather-user"></i><span>Profilim</span></a></li>
                                            @if (User.IsInRole("Admin"))
                                            {
                                                <li><a href="/Admin/Dashboard"><i class="feather-home"></i><span>Yönetim Paneli</span></a></li>
                                            }
                                        </ul>
                                        <hr class="mt--10 mb--10">
                                        <ul class="user-list-wrapper">
                                            <li>
                                                <form method="post" action="/Account/Logout">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="rbt-btn-link" style="border:none;background:none;padding:0;"><i class="feather-log-out"></i><span> Çıkış Yap</span></button>
                                                </form>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>

                    <div class="rbt-btn-wrapper d-none d-xl-block">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a class="rbt-btn btn-border-gradient radius-round btn-sm hover-transform-none" href="/Account/Profile">
                                <span>Hesabım</span>
                            </a>
                        }
                        else
                        {
                            <a class="rbt-btn btn-border-gradient radius-round btn-sm hover-transform-none" href="/Account/Login">
                                <span>Giriş Yap</span>
                            </a>
                        }
                    </div>

                    <!-- Start Mobile-Menu-Bar -->
                    <div class="mobile-menu-bar d-block d-xl-none">
                        <div class="hamberger">
                            <button class="hamberger-button rbt-round-btn">
                                <i class="feather-menu"></i>
                            </button>
                        </div>
                    </div>
                    <!-- End Mobile-Menu-Bar -->
                </div>
            </div>
        </div>

        <!-- Start Search Dropdown  -->
        <div class="rbt-search-dropdown">
            <div class="wrapper">
                <div class="row">
                    <div class="col-lg-12">
                        <form action="/Product" method="get">
                            <input type="text" name="search" placeholder="Ne arıyorsunuz?">
                            <div class="submit-btn">
                                <button class="rbt-btn btn-gradient btn-md" type="submit">Ara</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        <!-- End Search Dropdown  -->
    </div>
</header>
<!-- End Header Area -->

<!-- Start Mobile Menu -->
<div class="popup-mobile-menu">
    <div class="inner-wrapper">
        <div class="inner-top">
            <div class="content">
                <div class="logo">
                    <a href="/"><span class="logo-text">@siteTitle</span></a>
                </div>
                <div class="rbt-btn-close">
                    <button class="close-button rbt-round-btn"><i class="feather-x"></i></button>
                </div>
            </div>
            <p class="description">@(Model.Settings.GetValueOrDefault("FooterText") ?? "Geleneksel lezzetler, modern dokunuş.")</p>
            <ul class="navbar-top-left rbt-information-list justify-content-start">
                @if (!string.IsNullOrWhiteSpace(Model.Settings.GetValueOrDefault("ContactEmail")))
                {
                    <li><a href="mailto:@Model.Settings.GetValueOrDefault("ContactEmail")"><i class="feather-mail"></i>@Model.Settings.GetValueOrDefault("ContactEmail")</a></li>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Settings.GetValueOrDefault("ContactPhone")))
                {
                    <li><a href="tel:@Model.Settings.GetValueOrDefault("ContactPhone")"><i class="feather-phone"></i>@Model.Settings.GetValueOrDefault("ContactPhone")</a></li>
                }
            </ul>
        </div>
        <nav class="mainmenu-nav">
            <ul class="mainmenu">
                @{ RenderMenu(Model.Menu); }
                @if (Model.Categories.Any())
                {
                    <li class="has-dropdown has-menu-child-item">
                        <a href="/Product">Kategoriler <i class="feather-chevron-down"></i></a>
                        <ul class="submenu">
                            @foreach (var cat in Model.Categories.OrderBy(c => c.DisplayOrder))
                            {
                                <li><a href="/Category/@cat.Slug">@cat.Name</a></li>
                            }
                        </ul>
                    </li>
                }
            </ul>
        </nav>
    </div>
</div>
<!-- End Mobile Menu -->
